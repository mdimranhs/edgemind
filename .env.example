# Cloud inference provider (hf_api for cloud / Hugging Face Spaces / Railway)
LLM_PROVIDER=hf_api

# Hugging Face model served through the Inference API
HF_MODEL=Qwen/Qwen3-8B

# Hugging Face access token (never commit real tokens to git)
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxx

DEBUG=false

# Retrieval-Augmented Generation (RAG) & Web Search
WEB_SEARCH_ENABLED=true
RAG_LOCAL_FILES_ONLY=false
MAX_RETRIEVED_CHUNKS=3
MEMORY_BACKEND=none

# Guardrails and Context Limits
MAX_HISTORY_MESSAGES=8
MAX_MESSAGE_CHARS=2000
MAX_GENERATION_TOKENS=1024
MAX_PROMPT_TOKENS=4096

# Timeouts, Concurrency, Rate Limiting & CORS
HF_REQUEST_TIMEOUT=30.0
MAX_CONCURRENT_REQUESTS=4
RATE_LIMIT_PER_MINUTE=30
CORS_ALLOWED_ORIGINS=*

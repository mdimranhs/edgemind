# Railway environment variables — copy to Railway, never commit real values.
# Managed in code by .railway/railway.ts (set there unless marked "keep on Railway").

# Cloud inference provider on Railway (needs a GPU-free build, uses HF Inference API)
LLM_PROVIDER=hf_api

# Hugging Face model served through the Inference API
HF_MODEL=Qwen/Qwen2.5-7B-Instruct

# Hugging Face access token — set on Railway via `railway variables set`, keep out of git
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxx

DEBUG=false

# Allow web search fallback and keep RAG grounded in the bundled knowledge base
WEB_SEARCH_ENABLED=true
RAG_LOCAL_FILES_ONLY=true